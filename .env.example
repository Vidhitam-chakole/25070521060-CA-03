# ==========================================
# LearnWithFun Frontend Environment Variables
# ==========================================

# Backend API Base URL
# - Development: Leave empty ("") to use Vite's dev proxy (/api -> localhost:5000)
# - Production (e.g. Vercel deployment): Set to your deployed backend URL:
#   VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
