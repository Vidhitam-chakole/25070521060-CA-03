# =================================================================
# SpeechPact / LearnWithFun - Full-Stack Architecture Variables
# =================================================================

# -----------------------------------------------------------------
# 1. FRONTEND (Vercel Dashboard -> Settings -> Environment Variables)
# -----------------------------------------------------------------
# Set VITE_API_URL to your Render backend web service URL
# Example: https://speechpact-backend.onrender.com
# Leave empty for local development to use Vite's proxy (/api -> localhost:5000)
VITE_API_URL=

# -----------------------------------------------------------------
# 2. BACKEND (Render Dashboard -> Service -> Environment)
# -----------------------------------------------------------------
# Port is dynamically assigned by Render (default 10000 or 5000)
PORT=5000

# MongoDB Database Connection String (MongoDB Atlas cluster or local)
# Supported variable names: DATABASE_URL or MONGO_URI
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/learnwithfun?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/learnwithfun?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a long, secure random string)
JWT_SECRET=your_super_secret_jwt_key_here_render_2026

# Node Environment
NODE_ENV=production

# Allowed CORS Origins (comma-separated origins allowed to talk to backend)
# Include your Vercel frontend domain and localhost for dev
CORS_ORIGIN=https://exploreandlearn.vercel.app,http://localhost:5173
