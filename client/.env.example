# =================================================================
# LearnWithFun / SpeechPact - Frontend Environment Variables
# Placed in Vercel Dashboard -> Project -> Settings -> Environment Variables
# =================================================================

# Backend API Base URL
# - Production (Vercel): Set to your deployed Render backend web service URL:
#   VITE_API_URL=https://<your-backend-name>.onrender.com
# - Local Development: Leave empty ("") to let Vite automatically proxy /api requests to localhost:5000
VITE_API_URL=
