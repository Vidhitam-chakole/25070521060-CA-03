# ==========================================
# LearnWithFun Backend Environment Variables
# ==========================================

# Server Port (Render / Railway / Heroku will set this automatically)
PORT=5000

# MongoDB Connection String
# Local Compass: mongodb://127.0.0.1:27017/learnwithfun
# Production Atlas: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/learnwithfun?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/learnwithfun

# JWT Signing Secret Key (Must be set to a secure unique random string in production)
JWT_SECRET=learnwithfun_pixel_secret_key_2026

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed CORS Origins (comma-separated, e.g. https://your-frontend.vercel.app,http://localhost:5173 or * for open)
CORS_ORIGIN=*
