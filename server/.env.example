# =================================================================
# LearnWithFun / SpeechPact - Backend Environment Variables
# Placed in Render Dashboard -> Service -> Environment
# =================================================================

# Server Port
# Note: Render dynamically sets PORT in production. Hardcoding is optional.
PORT=5000

# MongoDB Connection String (Atlas production or local instance)
# Supported keys: DATABASE_URL or MONGO_URI
# Local: mongodb://127.0.0.1:27017/learnwithfun
# Atlas: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/learnwithfun?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/learnwithfun?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/learnwithfun?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a random 32+ char secret in production)
JWT_SECRET=your_super_secret_jwt_key_here_render_2026

# Node Environment ('production' for Render, 'development' for local)
NODE_ENV=production

# Allowed CORS Origins (comma-separated list of origins)
# Include your Vercel frontend domain and localhost for dev
CORS_ORIGIN=https://exploreandlearn.vercel.app,http://localhost:5173
